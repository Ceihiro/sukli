<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutCinematicRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0812">

    <!-- Cinematic Vignette & Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Status Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCinematicChapter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.12"
                android:text="STORY PROLOGUE • CHAPTER 1: 'I HAVE NO CHANGE'"
                android:textColor="@color/store_yellow_jeepney"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Skip Button -->
            <Button
                android:id="@+id/btnSkipCinematic"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="#424242"
                android:letterSpacing="0.08"
                android:text="SKIP PROLOGUE (>>)"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Main Visual Stage (Sprite / Scene Canvas) -->
        <FrameLayout
            android:id="@+id/frameSceneStage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1">

            <!-- Background Atmosphere Glow -->
            <View
                android:id="@+id/viewAtmosphereGlow"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_background"
                android:alpha="0.2" />

            <!-- Animated Stage Visuals -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSceneEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏥"
                    android:textSize="84sp" />

                <TextView
                    android:id="@+id/tvSceneBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_status_pill"
                    android:text="DISTRICT HOSPITAL • 3:00 AM"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Sunlight Burst Overlay for Scene 6 -->
            <View
                android:id="@+id/viewSunlightFlash"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFF59D"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Cinematic Subtitle Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_tindahan"
            android:elevation="4dp"
            android:gravity="center"
            android:minHeight="68dp"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="10dp"
            android:paddingEnd="24dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvCinematicSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:text="&quot;Kiko, your grandmother Lola Carmen is critically ill. You need ₱10,000 for her medical bills and dialysis before the month ends...&quot;"
                android:textColor="@color/store_wood_dark"
                android:textSize="14.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Scene Progress Bar -->
        <ProgressBar
            android:id="@+id/pbCinematicProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:max="6"
            android:progress="0"
            android:progressTint="@color/store_yellow_jeepney" />
    </LinearLayout>

</FrameLayout>
