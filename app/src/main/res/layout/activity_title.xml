<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_title_screen">

    <!-- Version Badge (Clean Top-Left Corner, NEVER overlaps buttons) -->
    <LinearLayout
        android:id="@+id/layoutVersionBadge"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card_tindahan"
        android:paddingHorizontal="10dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SUKLI v0.9.5"
            android:textColor="#FFD54F"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • DEMO BUILD"
            android:textColor="#D7CCC8"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Developer Notes Button (Clean Top-Right Corner, NEVER overlaps buttons) -->
    <LinearLayout
        android:id="@+id/btnDevRoadmap"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_btn_wood_interactive"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 DEV NOTES"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Title Logo & Central Action Menu Container (Unobstructed in Center) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Illustrated Title Logo -->
        <ImageView
            android:id="@+id/ivTitleLogo"
            android:layout_width="280dp"
            android:layout_height="80dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ui_logo_sukli"
            android:contentDescription="Sukli Logo" />

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sari-Sari Stories"
            android:textColor="#FFE082"
            android:textSize="15sp"
            android:textStyle="bold"
            android:shadowColor="#3E2723"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:layout_marginTop="-2dp"
            android:layout_marginBottom="12dp" />

        <!-- Illustrated PLAY / CONTINUE Button -->
        <FrameLayout
            android:id="@+id/btnPlay"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:background="@drawable/ui_btn_orange"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvPlayLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="PLAY"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:shadowColor="#BF360C"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="2" />
        </FrameLayout>

        <!-- New Game / Reset Button (Shown when saved progress exists) -->
        <FrameLayout
            android:id="@+id/btnNewGame"
            android:layout_width="220dp"
            android:layout_height="40dp"
            android:background="@drawable/ui_btn_gray"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="NEW GAME (RESET)"
                android:textColor="#FFF8E1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:shadowColor="#424242"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="1" />
        </FrameLayout>

        <!-- Illustrated STORY ROADMAP Button -->
        <FrameLayout
            android:id="@+id/btnChapters"
            android:layout_width="220dp"
            android:layout_height="40dp"
            android:background="@drawable/ui_btn_gray"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="STORY ROADMAP"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:shadowColor="#424242"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2" />
        </FrameLayout>

        <!-- Bottom Row: ABOUT & AUDIO SETTINGS -->
        <LinearLayout
            android:layout_width="220dp"
            android:layout_height="40dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/ui_btn_gray"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="ABOUT"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:shadowColor="#424242"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="1" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnAudioSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/ui_btn_gray"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="⚙️ AUDIO"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:shadowColor="#424242"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="1" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
