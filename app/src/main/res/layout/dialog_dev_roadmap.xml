<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="540dp"
    android:layout_height="wrap_content"
    android:background="@drawable/ui_panel_modal"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📋 DEVELOPER NOTES &amp; ROADMAP"
            android:textColor="#3E2723"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2E7D32"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="v0.9.5 DEMO BUILD"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnDevRoadmapClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="✕"
            android:textColor="#8D6E63"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Planned Features &amp; Next Sprints for Team Presentation"
        android:textColor="#8D6E63"
        android:textSize="11sp"
        android:textStyle="italic"
        android:layout_marginBottom="10dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="#33000000"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Item 1: Full 30-Day Narrative -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_tindahan"
                android:padding="10dp"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. 🎮 Full 30-Day Barangay Narrative &amp; Medical Goal"
                    android:textColor="#E65100"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="• Expanding from 1-day demo to full 30-day story arc across 5 Chapters.\n• Goal: Raise ₱10,000 for Lola Carmen's hospital dialysis.\n• Moral choices: When to extend utang to struggling neighbors vs saving for hospital fund."
                    android:textColor="#D7CCC8"
                    android:textSize="10.5sp"
                    android:lineSpacingMultiplier="1.25" />
            </LinearLayout>

            <!-- Item 2: Philippine Environmental Ambience -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_tindahan"
                android:padding="10dp"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. 🎙️ Authentic Barangay Audio &amp; Environmental Ambience"
                    android:textColor="#E65100"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="• Real field recordings: passing 2-stroke tricycles, jeepney horns, taho &amp; ice cream bells, morning pandesal vendor megaphones, chapel novena bells, and kids playing patintero.\n• Ambient cues will dynamically signal incoming special customers."
                    android:textColor="#D7CCC8"
                    android:textSize="10.5sp"
                    android:lineSpacingMultiplier="1.25" />
            </LinearLayout>

            <!-- Item 3: Transistor Radio -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_tindahan"
                android:padding="10dp"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. 📻 Working Transistor Radio (AM/FM Barangay Stations)"
                    android:textColor="#E65100"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="• Interactive shelf radio: tune between DZBB News, Love Radio drama advice, and classic retro OPM hits.\n• Radio broadcasts provide weather warnings (typhoons) that affect customer traffic."
                    android:textColor="#D7CCC8"
                    android:textSize="10.5sp"
                    android:lineSpacingMultiplier="1.25" />
            </LinearLayout>

            <!-- Item 4: Utang Ledger Mini-Game -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_tindahan"
                android:padding="10dp"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. 📖 Utang Ledger Notebook (Credit &amp; Trust Mini-Game)"
                    android:textColor="#E65100"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="• Spiral notebook interface to track customer debts (Mang Jerry, Aling Myrna).\n• Reading challenge: Decode handwritten promissory notes and calculate interest/settlement on paydays."
                    android:textColor="#D7CCC8"
                    android:textSize="10.5sp"
                    android:lineSpacingMultiplier="1.25" />
            </LinearLayout>

            <!-- Item 5: Supplier Restock Logistics -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_tindahan"
                android:padding="10dp"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5. 🚚 Kuya Joms Restock Delivery Van Mini-Game"
                    android:textColor="#E65100"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="• Weekly wholesale distributor truck arrival.\n• Budget management: Buying in bulk at wholesale discount vs keeping cash on hand for customer sukli."
                    android:textColor="#D7CCC8"
                    android:textSize="10.5sp"
                    android:lineSpacingMultiplier="1.25" />
            </LinearLayout>

            <!-- Item 6: Expanded Sari-Sari Inventory -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_tindahan"
                android:padding="10dp"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6. 🛒 16+ Authentic Philippine Products"
                    android:textColor="#E65100"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="• Adding Silver Swan Toyo, Datu Puti Suka, Sardinas 555, Lucky Me! Pancit Canton, Palmolive sachets, Bear Brand, Milo, and Chocnut.\n• Shelf tier unlocks as store earns profit."
                    android:textColor="#D7CCC8"
                    android:textSize="10.5sp"
                    android:lineSpacingMultiplier="1.25" />
            </LinearLayout>

            <!-- Item 7: Educational Analytics Dashboard -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_tindahan"
                android:padding="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7. 📊 Teacher &amp; Parent Literacy Evaluation Dashboard"
                    android:textColor="#E65100"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="• Tracks reading comprehension percentage, hesitation rate, and vocabulary fluency.\n• Aligns with DepEd &amp; World Bank Philippine Early Grade Reading Assessment (EGRA) criteria."
                    android:textColor="#D7CCC8"
                    android:textSize="10.5sp"
                    android:lineSpacingMultiplier="1.25" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Close button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDevRoadmapOk"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/ui_btn_orange"
        android:text="UNDERSTOOD (CLOSE)"
        android:textColor="#FFFFFF"
        android:textSize="12.5sp"
        android:textStyle="bold" />

</LinearLayout>

