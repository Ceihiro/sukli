<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="380dp"
    android:layout_height="wrap_content"
    android:background="@drawable/ui_panel_modal"
    android:padding="20dp"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ui_cash_register"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TINDERO CALCULATOR"
            android:textColor="#3E2723"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCalcClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#8D6E63"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Vintage Green LCD Display Screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2E3A23"
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvCalcHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text=""
            android:textColor="#A5C68A"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="start" />

        <TextView
            android:id="@+id/tvCalcDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0"
            android:textColor="#D7F5BD"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Quick Sari-Sari Helper Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCalcHelperTotal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Due (Order)"
            android:textSize="10.5sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/ui_btn_gray"
            android:layout_marginEnd="4dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCalcHelperPaid"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Paid Bill"
            android:textSize="10.5sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/ui_btn_gray"
            android:layout_marginEnd="4dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCalcHelperSukli"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="= SUKLI"
            android:textSize="10.5sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/ui_btn_orange" />
    </LinearLayout>

    <!-- Keypad Grid (Standard Calculator Layout) -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:alignmentMode="alignMargins">

        <!-- Row 1: C, DEL, /, * -->
        <Button
            android:id="@+id/btnCalcC"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:text="C"
            android:textSize="14sp"
            android:backgroundTint="#B71C1C"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnCalcDel"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:text="DEL"
            android:textSize="12sp"
            android:backgroundTint="#5D4037"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnCalcDiv"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:text="÷"
            android:textSize="16sp"
            android:backgroundTint="#8D6E63"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnCalcMul"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:text="×"
            android:textSize="16sp"
            android:backgroundTint="#8D6E63"
            android:textColor="#FFFFFF" />

        <!-- Row 2: 7, 8, 9, - -->
        <Button
            android:id="@+id/btnCalc7"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:text="7"
            android:textSize="15sp"
            android:backgroundTint="#4E342E"
            android:textColor="#FFF8E1" />

        <Button
            android:id="@+id/btnCalc8"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:text="8"
            android:textSize="15sp"
            android:backgroundTint="#4E342E"
            android:textColor="#FFF8E1" />

        <Button
            android:id="@+id/btnCalc9"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:text="9"
            android:textSize="15sp"
            android:backgroundTint="#4E342E"
            android:textColor="#FFF8E1" />

        <Button
            android:id="@+id/btnCalcSub"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:text="-"
            android:textSize="18sp"
            android:backgroundTint="#8D6E63"
            android:textColor="#FFFFFF" />

        <!-- Row 3: 4, 5, 6, + -->
        <Button
            android:id="@+id/btnCalc4"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:text="4"
            android:textSize="15sp"
            android:backgroundTint="#4E342E"
            android:textColor="#FFF8E1" />

        <Button
            android:id="@+id/btnCalc5"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:text="5"
            android:textSize="15sp"
            android:backgroundTint="#4E342E"
            android:textColor="#FFF8E1" />

        <Button
            android:id="@+id/btnCalc6"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:text="6"
            android:textSize="15sp"
            android:backgroundTint="#4E342E"
            android:textColor="#FFF8E1" />

        <Button
            android:id="@+id/btnCalcAdd"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:text="+"
            android:textSize="18sp"
            android:backgroundTint="#8D6E63"
            android:textColor="#FFFFFF" />

        <!-- Row 4: 1, 2, 3, = -->
        <Button
            android:id="@+id/btnCalc1"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:text="1"
            android:textSize="15sp"
            android:backgroundTint="#4E342E"
            android:textColor="#FFF8E1" />

        <Button
            android:id="@+id/btnCalc2"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:text="2"
            android:textSize="15sp"
            android:backgroundTint="#4E342E"
            android:textColor="#FFF8E1" />

        <Button
            android:id="@+id/btnCalc3"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:text="3"
            android:textSize="15sp"
            android:backgroundTint="#4E342E"
            android:textColor="#FFF8E1" />

        <Button
            android:id="@+id/btnCalcEq"
            android:layout_width="0dp"
            android:layout_height="78dp"
            android:layout_columnWeight="1"
            android:layout_rowSpan="2"
            android:layout_margin="2dp"
            android:text="="
            android:textSize="22sp"
            android:textStyle="bold"
            android:backgroundTint="#E65100"
            android:textColor="#FFFFFF" />

        <!-- Row 5: 0, 00, . -->
        <Button
            android:id="@+id/btnCalc0"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:text="0"
            android:textSize="15sp"
            android:backgroundTint="#4E342E"
            android:textColor="#FFF8E1" />

        <Button
            android:id="@+id/btnCalc00"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:text="00"
            android:textSize="13sp"
            android:backgroundTint="#4E342E"
            android:textColor="#FFF8E1" />

        <Button
            android:id="@+id/btnCalcDot"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:text="."
            android:textSize="18sp"
            android:backgroundTint="#4E342E"
            android:textColor="#FFF8E1" />
    </GridLayout>

</LinearLayout>

