<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8E1">

    <TextView
        android:id="@+id/tvDayComplete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Day 1 Complete!"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#E65100"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvStars"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tvStars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="★★★"
        android:textSize="64sp"
        android:textColor="#FFC107"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvDayComplete"
        app:layout_constraintBottom_toTopOf="@id/tvProfit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvProfit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Profit: P0"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvStars"
        app:layout_constraintBottom_toTopOf="@id/tvCustomers"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvCustomers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Customers Served: 0"
        android:textSize="20sp"
        android:textColor="#555555"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvProfit"
        app:layout_constraintBottom_toTopOf="@id/btnNextDay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnNextDay"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:text="NEXT DAY"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#4CAF50"
        app:layout_constraintTop_toBottomOf="@id/tvCustomers"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="48dp" />

</androidx.constraintlayout.widget.ConstraintLayout>