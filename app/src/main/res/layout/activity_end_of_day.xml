<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A0E0A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="16dp"
        android:baselineAligned="false">

        <!-- Left Column: Night Banner, Stars & Financial Breakdown -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDayComplete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌙 Day 1 Completed!"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvChapterSubhead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chapter 1: 'I Have No Change'"
                    android:textColor="@color/store_yellow_jeepney"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <ImageView
                        android:id="@+id/ivStar1"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ui_star_filled" />

                    <ImageView
                        android:id="@+id/ivStar2"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ui_star_filled" />

                    <ImageView
                        android:id="@+id/ivStar3"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ui_star_filled" />

                    <TextView
                        android:id="@+id/tvStars"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:text="★★★" />
                </LinearLayout>

                <!-- Financial Statement Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_card_tindahan"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊 Daily Accounting Breakdown"
                        android:textColor="@color/store_wood_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Gross Sales:"
                            android:textColor="@color/text_primary"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tvGrossSales"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱120"
                            android:textColor="@color/store_green_money"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Wholesale Cost (COGS):"
                            android:textColor="@color/text_primary"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tvWholesaleCost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-₱80"
                            android:textColor="@color/store_red_warning"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Electricity Bill (Fan):"
                            android:textColor="@color/text_primary"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tvElectricBill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-₱25"
                            android:textColor="@color/store_red_warning"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Customer Credit (Utang):"
                            android:textColor="@color/text_primary"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tvUtangGiven"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱0"
                            android:textColor="@color/store_orange"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Net Store Profit:"
                            android:textColor="@color/store_wood_dark"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProfit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱45"
                            android:textColor="@color/store_green_money"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Hospital Fund Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_card_tindahan"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tvHospitalFundProgressText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lola Carmen's Medical Fund: ₱1,500 / ₱10,000"
                        android:textColor="@color/store_green_money"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/pbHospitalFundReview"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="3dp"
                        android:max="10000"
                        android:progress="1500"
                        android:progressTint="@color/store_green_money" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Right Column: Educational Report & Actions -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:paddingStart="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Educational Report Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_tindahan"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎓 Literacy &amp; Mental Math Report"
                        android:textColor="@color/store_wood_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReadingComprehensionScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="📖 Reading Comprehension: 100%"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCustomers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="👥 Customers Served: 4"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvPerformanceAdvice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Teacher Fe's Tip: 'Excellent work, Kiko! You understood the customers on the first try without needing hints!'"
                        android:textColor="@color/store_orange"
                        android:textSize="11sp"
                        android:textStyle="italic" />
                </LinearLayout>

                <!-- Actions -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnNextDay"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/ui_btn_orange"
                    android:text="▶ OPEN NEXT DAY"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnRestockKuyaJoms"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/ui_btn_gray"
                        android:text="🛵 Restock"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnReturnToTitle"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/ui_btn_gray"
                        android:text="🏠 Title Menu"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</FrameLayout>
